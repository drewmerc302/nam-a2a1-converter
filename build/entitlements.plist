<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions a frozen CPython + PyTorch app needs.

  allow-jit / allow-unsigned-executable-memory: torch and CPython both generate and
  execute code at runtime.
  disable-library-validation: the app dlopen()s dylibs out of Contents/Frameworks;
  without this, library validation can refuse them inside a signed bundle.

  All three are permitted under notarization.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
